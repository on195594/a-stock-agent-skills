              "100000",
              "--json"
            ],
            "required": true,
            "operation": "execute_cli"
          },
          {
            "capability": "skill_reference_read",
            "operation": "read_skill_reference",
            "resource_suffix": "a-stock-monitor/references/data-operations.md"
          }
        ],
        "max_tool_calls": 2,
        "required_output_fields": [
          "route",
          "status",
          "tool_calls",
          "tool_call_count",
          "stopped",
          "stop_condition",
          "block_reason",
          "result.action_status"
        ],
        "forbidden_actions": [
          "route:Research",
          "route:QA",
          "execute:W1",
          "capability:web_search"
        ],
        "stop_condition": {
          "stopped": true,
          "route": "Monitor",
          "status": [
            "blocked",
            "fail_closed"
          ],
          "nonempty": true
        },
        "expected_block_reason": {
          "required": true
        }
      },
      "expected_output": {
        "route": "Monitor",
        "status": [
          "blocked",
          "fail_closed"
        ],
        "result": {
          "action_status": "trade_candidate"
        }
      }
    },
